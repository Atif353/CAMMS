generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  permissions String?
  createdAt   DateTime @default(now()) @map("created_at")

  users User[]

  @@map("roles")
}

model User {
  id           String    @id @default(uuid())
  name         String    @db.VarChar(100)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  phone        String?   @db.VarChar(20)
  profileImage String?   @map("profile_image") @db.VarChar(500)
  roleId       Int       @map("role_id")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  role         Role           @relation(fields: [roleId], references: [id])
  activities   Activity[]
  notifications Notification[]
  reportsGenerated Report[] @relation("GeneratedBy")
  reportsInstructor Report[] @relation("Instructor")

  @@map("users")
}

model ActivityType {
  id          Int       @id @default(autoincrement())
  code        String    @unique @db.VarChar(50)
  label       String    @db.VarChar(100)
  description String?

  activities Activity[]

  @@map("activity_types")
}

model Activity {
  id              String    @id @default(uuid())
  instructorId    String    @map("instructor_id")
  activityTypeId  Int       @map("activity_type_id")
  title           String    @db.VarChar(200)
  description     String?
  courseCode      String?   @map("course_code") @db.VarChar(20)
  timeSpentMinutes Int      @map("time_spent_minutes")
  activityDate    DateTime  @map("activity_date") @db.Date
  meta            Json      @default("{}")
  status          String    @default("COMPLETED") @db.VarChar(20)
  isDeleted       Boolean   @default(false) @map("is_deleted")
  createdAt       DateTime  @default(now()) @map("created_at")

  instructor      User         @relation(fields: [instructorId], references: [id])
  activityType    ActivityType @relation(fields: [activityTypeId], references: [id])

  @@index([instructorId, activityDate])
  @@index([activityTypeId])
  @@index([activityDate])
  @@index([status])
  @@map("activities")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  title     String   @db.VarChar(200)
  message   String
  type      String   @db.VarChar(20)
  priority  String   @db.VarChar(20)
  isRead    Boolean  @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  meta      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, isRead])
  @@map("notifications")
}

model Report {
  id          Int      @id @default(autoincrement())
  generatedBy String   @map("generated_by")
  instructorId String? @map("instructor_id")
  reportType  String   @map("report_type") @db.VarChar(20)
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date
  filters     Json     @default("{}")
  filePath    String?  @map("file_path") @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")

  generatedByUser User? @relation("GeneratedBy", fields: [generatedBy], references: [id])
  instructor      User? @relation("Instructor", fields: [instructorId], references: [id])

  @@index([generatedBy])
  @@index([instructorId])
  @@index([startDate, endDate])
  @@map("reports")
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(100)
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}
